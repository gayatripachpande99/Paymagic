PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration (Single Source of Truth)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paymagic
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=paymagic
PGSSL=false

# Authentication & Security
JWT_SECRET=paymagic_enterprise_jwt_secret_key_2026
JWT_REFRESH_SECRET=paymagic_enterprise_refresh_token_secret_2026

# Telephony & Omnichannel Calling Hours (RBI Fair Practice: 08:00 - 19:00 IST)
TELEPHONY_WEBHOOK_SECRET=paymagic_telephony_webhook_hmac_secret_2026
TELEPHONY_PROVIDER=mock
CALLING_HOURS_START=8
CALLING_HOURS_END=19

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://paymagic.in,https://www.paymagic.in
